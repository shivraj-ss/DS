#include <iostream>
#include <queue>
using namespace std;

int main()
{
    queue<int> q;
    int choice, token = 1;

    do
    {
        cout << "\n1. Issue Token";
        cout << "\n2. Display All Tokens";
        cout << "\n3. Serve Customer";
        cout << "\n4. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                q.push(token);
                cout << "Token issued: " << token << endl;
                token++;
                break;

            case 2:
                if (q.empty())
                    cout << "No tokens available\n";
                else
                {
                    queue<int> temp = q;
                    while (!temp.empty())
                    {
                        cout << temp.front() << " ";
                        temp.pop();
                    }
                    cout << endl;
                }
                break;

            case 3:
                if (q.empty())
                    cout << "No customers to serve\n";
                else
                {
                    cout << "Serving Token: " << q.front() << endl;
                    q.pop();
                }
                break;

            case 4:
                cout << "Exiting program\n";
                break;

            default:
                cout << "Invalid choice\n";
        }
    } while (choice != 4);

    return 0;
}
