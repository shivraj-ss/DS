#include <iostream>
using namespace std;

int main() {
    int bookID[5], searchID;
    bool found = false;

    cout << "Enter IDs of 5 library books:" << endl;

    for (int i = 0; i < 5; i++) {
        cin >> bookID[i];
    }

    cout << "Enter Book ID to search: ";
    cin >> searchID;

    for (int i = 0; i < 5; i++) {
        if (bookID[i] == searchID) {
            found = true;
            break;
        }
    }

    if (found)
        cout << "Book Found";
    else
        cout << "Book Not Found";

    return 0;
}
