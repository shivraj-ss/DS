#include <iostream>
using namespace std;

int main() {
    int bookID[5], temp;

    cout << "Enter IDs of 5 library books:" << endl;

    for (int i = 0; i < 5; i++) {
        cin >> bookID[i];
    }

    // Bubble Sort
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4 - i; j++) {
            if (bookID[j] > bookID[j + 1]) {
                temp = bookID[j];
                bookID[j] = bookID[j + 1];
                bookID[j + 1] = temp;
            }
        }
    }

    cout << "Book IDs in ascending order:" << endl;

    for (int i = 0; i < 5; i++) {
        cout << bookID[i] << " ";
    }

    return 0;
}
